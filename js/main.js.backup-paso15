const vaoOrbitaTrucha = crearVAOLinea(puntosOrbitaTrucha);

// Paso 14: línea del chorro de la cascada (toma -> A -> B -> C).
// Secuencia descendiente O -> E. Se crea el VAO una sola vez.
function crearLineaCascada() {
    const puntos = [];
    // Punto alto de la toma.
    puntos.push(POS_TOMA[0], POS_TOMA[1] + 1.2, POS_TOMA[2]);
    // A (entrada por encima).
    puntos.push(POS_ESTANQUE_A[0] - TAM_ESTANQUE_A[0] / 2, POS_ESTANQUE_A[1] + TAM_ESTANQUE_A[1] * 0.75, POS_ESTANQUE_A[2]);
    // B.
    puntos.push(POS_ESTANQUE_B[0] - TAM_ESTANQUE_B[0] / 2, POS_ESTANQUE_B[1] + TAM_ESTANQUE_B[1] * 0.75, POS_ESTANQUE_B[2]);
    // C (desague corto, NUNCA al lago).
    puntos.push(POS_ESTANQUE_C[0] - TAM_ESTANQUE_C[0] / 2, POS_ESTANQUE_C[1] + TAM_ESTANQUE_C[1] * 0.7, POS_ESTANQUE_C[2]);
    return puntos;
}
const puntosCascada = crearLineaCascada();
const vaoCascada = crearVAOLinea(puntosCascada);

// Paso 14: línea del cerco perimetral (POLYGONAL cerrado).
function crearLineaCerco() {
    const puntos = [];
    const radioCerco = 40;
    const numPostes = 24;
    for (let i = 0; i < numPostes; i++) {
        const ang = (i / numPostes) * Math.PI * 2;
        puntos.push(Math.cos(ang) * radioCerco, 0.2, Math.sin(ang) * radioCerco);
    }
    return puntos;
}
const puntosCerco = crearLineaCerco();
const vaoCerco = crearVAOLinea(puntosCerco);

// ------------------------------------------------------------
// PASO 6 - CAMARA MVP (valores iniciales; ahora dinámicos Paso 15)
// ------------------------------------------------------------
// La viewMatrix se recalcula cada frame (Paso 15). Se envía a ambos
// programas (superficie + línea) en el render loop.
let viewMatrix = obtenerViewCamara();

// ------------------------------------------------------------
// FUNCION DE DIBUJO REUTILIZABLE (superficie)
// Se EXTIEDE con uEmissive y uLightPosition/uLightFalloff (Paso 12).
// ------------------------------------------------------------
function dibujar(malla, modelo, opciones = {}) {
    const {
        color = [1, 1, 1],
        textura = null,
        usarLuz = true,
        uvOffset = [0, 0],
        cull = true,
        emisivo = false            // Paso 10: brilla sin iluminacion
    } = opciones;

    gl.useProgram(program);
    gl.uniformMatrix4fv(uModel, false, modelo);
    const normalMat = normalDesdeModelo(modelo);
    gl.uniformMatrix3fv(uNormalMat, false, normalMat);
    gl.uniform3fv(uColor, color);
    gl.uniform1i(uUseTex, textura ? 1 : 0);
    if (textura) {
        gl.activeTexture(gl.TEXTURE0);
        gl.bindTexture(gl.TEXTURE_2D, textura);
        gl.uniform1i(uTex, 0);
    }
    gl.uniform2fv(uUvOff, uvOffset);
    gl.uniform1i(uUseLight, usarLuz ? 1 : 0);
    gl.uniform3fv(uSunDir, direccionSol(estado.horaDia));
    gl.uniform1f(uAmbient, 0.12);            // Paso 12: ambiental reducido (sol puntual dominante)
    gl.uniform1i(uEmissive, emisivo ? 1 : 0); // Paso 10

    // Paso 12: posición puntual del sol celeste + atenuación.
    const solPos = posicionSolPuntual(estado.horaDia);
    gl.uniform3fv(uLightPosition, solPos);
    gl.uniform1f(uLightFalloff, intensidadSolar(estado.horaDia));

    if (cull) { gl.enable(gl.CULL_FACE); } else { gl.disable(gl.CULL_FACE); }

    gl.bindVertexArray(malla.vao);
    gl.drawElements(gl.TRIANGLES, malla.count, gl.UNSIGNED_SHORT, 0);
    gl.bindVertexArray(null);
}

// Paso 14: dibujo de líneas (orbitas/cascada/cerco).
function dibujarLinea(vaoLinea, modelo, color) {
    gl.useProgram(programaLinea);
    gl.uniformMatrix4fv(uModelLinea, false, modelo);
    gl.uniform3f(uColorLinea, color[0], color[1], color[2]);
    gl.bindVertexArray(vaoLinea.vao);
    gl.drawArrays(gl.LINE_LOOP, 0, vaoLinea.cantidad);
    gl.bindVertexArray(null);
}

// Paso 14: dibujo de línea abierto (cascada usa LINE_STRIP).
function dibujarLineaStrip(vaoLinea, modelo, color) {
    gl.useProgram(programaLinea);
    gl.uniformMatrix4fv(uModelLinea, false, modelo);
    gl.uniform3f(uColorLinea, color[0], color[1], color[2]);
    gl.bindVertexArray(vaoLinea.vao);
    gl.drawArrays(gl.LINE_STRIP, 0, vaoLinea.cantidad);
    gl.bindVertexArray(null);
}

// ------------------------------------------------------------
// PASO 11/13 - JERARQUÍA DE TRANSFORMACIONES
// Paso 13 exige: scene -> estanque -> pez, y
// scene -> incubadora -> artesa -> agua.
// La cascada (toma->A->B->C) es una secuencia de traslaciones
// descendentes que modela el flujo por gravedad.
// ------------------------------------------------------------

// Helper Paso 13: posición del centro de un estanque.
function centroEstanque(estanque) {
    switch (estanque) {
        case "A": return [POS_ESTANQUE_A[0], POS_ESTANQUE_A[1], POS_ESTANQUE_A[2]];
        case "B": return [POS_ESTANQUE_B[0], POS_ESTANQUE_B[1], POS_ESTANQUE_B[2]];
        case "C": return [POS_ESTANQUE_C[0], POS_ESTANQUE_C[1], POS_ESTANQUE_C[2]];
        default: return [0, 0, 0];
    }
}
function elipseEstanque(estanque) {
    switch (estanque) {
        case "A": return ELIPSE_A;
        case "B": return ELIPSE_B;
        case "C": return ELIPSE_C;
        default: return ELIPSE_B;
    }
}

// ------------------------------------------------------------
// PASO 4 - RENDER LOOP
// requestAnimationFrame + deltaTime. Separar actualizar/renderizar.
// ------------------------------------------------------------
function actualizar(dt) {
    anguloGiroDemo += 0.3 * dt;
    estado.desplazamientoAgua += dt * 0.02;
    estado.aireador += dt * 2.0;

    // Paso 12: hora interna del ciclo día/noche (hook Fase 3).
    // Avanza con deltaTime; velocidadSimulacion configurable.
    estado.horaDia += (dt * estado.velocidadSimulacion) / 86400;
    if (estado.horaDia >= 24) estado.horaDia -= 24;

    // Paso 11: ángulos INTEGRADOS (no reloj×factor).
    const v = 1; // velocidad base integrada
    entidad.trucha.anguloOrbita += dt * v * 0.22;
    entidad.trucha.anguloPropio += dt * v * 0.15;
    entidad.boya.anguloPropio += dt * v * 0.3;
    entidad.aireador.angulo += dt * v * 1.0;
}

let anguloGiroDemo = 0;

function renderizar() {
    gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

    // Paso 15: View se recalcula cada frame y se envía a AMBOS programas.
    viewMatrix = obtenerViewCamara();

    gl.useProgram(program);
    gl.uniformMatrix4fv(uProjection, false, projMatrix);
    gl.uniformMatrix4fv(uView, false, viewMatrix);

    gl.useProgram(programaLinea);
    gl.uniformMatrix4fv(uProjectionLinea, false, projMatrix);
    gl.uniformMatrix4fv(uViewLinea, false, viewMatrix);

    // === PASO 14: DRAW DE LÍNEAS (orbitas/trayectorias/cerco) ===
    // Cascada (LINE_STRIP), orbita trucha B y cerco (LINE_LOOP).
    dibujarLineaStrip(vaoCascada, identidad(), [0.35, 0.55, 0.95]);
    dibujarLinea(vaoOrbitaTrucha, identidad(), [0.25, 0.65, 0.45]);
    dibujarLinea(vaoCerco, identidad(), [0.45, 0.35, 0.25]);

    // --- TERRENO ---
    dibujar(mallaTerreno, identidad(), {
        textura: texturaTerreno,
        usarLuz: true
    });

    // --- ESTANQUE A (techado) ---
    dibujar(mallaCaja, componerModelo(POS_ESTANQUE_A, 0, 0, 0, TAM_ESTANQUE_A), {
        textura: texturaConcreto,
        usarLuz: true
    });
    dibujar(mallaPlano, componerModelo(
        [POS_ESTANQUE_A[0], POS_ESTANQUE_A[1] + TAM_ESTANQUE_A[1] * 0.7, POS_ESTANQUE_A[2]],
        0, 0, 0,
        [TAM_ESTANQUE_A[0] * 0.9, 1, TAM_ESTANQUE_A[2] * 0.9]
    ), {
        textura: texturaAgua,
        usarLuz: true,
        uvOffset: [estado.desplazamientoAgua, 0],
        cull: false
    });
    // Techo de calamina.
    dibujar(mallaCaja, componerModelo(
        [POS_ESTANQUE_A[0], POS_ESTANQUE_A[1] + TAM_ESTANQUE_A[1] + 0.8, POS_ESTANQUE_A[2]],
        0, 0, 0,
        [TAM_ESTANQUE_A[0] + 1, 0.15, TAM_ESTANQUE_A[2] + 1]
    ), { textura: texturaCalamina, usarLuz: true });

    // --- ESTANQUE B (engorde, OUTDOOR: sin techo) ---
    dibujar(mallaCaja, componerModelo(POS_ESTANQUE_B, 0, 0, 0, TAM_ESTANQUE_B), {
        textura: texturaConcreto, usarLuz: true
    });
    dibujar(mallaPlano, componerModelo(
        [POS_ESTANQUE_B[0], POS_ESTANQUE_B[1] + TAM_ESTANQUE_B[1] * 0.7, POS_ESTANQUE_B[2]],
        0, 0, 0,
        [TAM_ESTANQUE_B[0] * 0.9, 1, TAM_ESTANQUE_B[2] * 0.9]
    ), {
        textura: texturaAgua, usarLuz: true,
        uvOffset: [estado.desplazamientoAgua * 1.2, 0], cull: false
    });

    // --- ESTANQUE C (descarga/sedimentacion, OUTDOOR, ULTIMO) ---
    dibujar(mallaCaja, componerModelo(POS_ESTANQUE_C, 0, 0, 0, TAM_ESTANQUE_C), {
        textura: texturaConcreto, usarLuz: true
    });
    dibujar(mallaPlano, componerModelo(
        [POS_ESTANQUE_C[0], POS_ESTANQUE_C[1] + TAM_ESTANQUE_C[1] * 0.6, POS_ESTANQUE_C[2]],
        0, 0, 0,
        [TAM_ESTANQUE_C[0] * 0.9, 1, TAM_ESTANQUE_C[2] * 0.9]
    ), {
        textura: texturaAgua, usarLuz: true,
        uvOffset: [estado.desplazamientoAgua * 0.8, 0], cull: false
    });
    // Canal de desague corto (NUNCA al lago).
    dibujar(mallaCaja, componerModelo(
        [POS_ESTANQUE_C[0] + TAM_ESTANQUE_C[0] / 2 + 2, POS_ESTANQUE_C[1], POS_ESTANQUE_C[2]],
        0, 0, 0, [3, 0.5, 1]
    ), { textura: texturaConcreto, usarLuz: true });

    // --- TOMA (compuerta en vertiente, NO deposito elevado) ---
    dibujar(mallaCaja, componerModelo(POS_TOMA, 0, 0, 0, [3, 2.5, 3]), {
        textura: texturaConcreto, usarLuz: true
    });
    // Compuerta (placa metalica).
    dibujar(mallaCaja, componerModelo(
        [POS_TOMA[0] + 1.8, POS_TOMA[1] + 1.5, POS_TOMA[2]],
        0, 0, 0, [0.2, 1.5, 2]
    ), { color: [0.4, 0.45, 0.5], usarLuz: true });

    // --- INCUBADORA (sala techada, interior NEGRO) ---
    // Paso 13: scene -> incubadora (nivel 1: traslación del edificio).
    const matrizIncubadora = componerModelo(POS_INCUBADORA, 0, 0, 0, TAM_INCUBADORA);
    dibujar(mallaCaja, matrizIncubadora, {
        textura: texturaConcreto, usarLuz: true
    });
    // Interior negro (artesas de incubacion pintadas de negro).
    dibujar(mallaCaja, componerModelo(
        [POS_INCUBADORA[0], POS_INCUBADORA[1] + 0.5, POS_INCUBADORA[2]],
        0, 0, 0,
        [TAM_INCUBADORA[0] - 1, TAM_INCUBADORA[1] - 1.2, TAM_INCUBADORA[2] - 1]
    ), { color: [0.05, 0.05, 0.05], usarLuz: false });
    // Techo de calamina.
    dibujar(mallaCaja, componerModelo(
        [POS_INCUBADORA[0], POS_INCUBADORA[1] + TAM_INCUBADORA[1] + 0.3, POS_INCUBADORA[2]],
        0, 0, 0,
        [TAM_INCUBADORA[0] + 1.5, 0.15, TAM_INCUBADORA[2] + 1]
    ), { textura: texturaCalamina, usarLuz: true });

    // --- ARTESAS de incubación (Paso 13: incubadora -> artesa -> agua) ---
    // La artesa hereda la TRASLACIÓN del padre (incubadora) pero NO su
    // escala (como en la guía: M_tierra_sistema ≠ M_tierra_visual).
    // M_mundo_artesa = T(incubadora) · T(local) · S(local)
    const matrizIncubadoraTraslacion = traslacion(
        POS_INCUBADORA[0], POS_INCUBADORA[1], POS_INCUBADORA[2]
    );
    for (let i = 0; i < 3; i++) {
        // Posición LOCAL relativa al origen de la incubadora.
        const localOffset = [-4 + i * 4, 0.3, -4];
        const mArtesaLocal = componerModelo(localOffset, 0, 0, 0, [3, 0.8, 1.2]);
        const mArtesaMundo = multiplicarMatrices(matrizIncubadoraTraslacion, mArtesaLocal);
        dibujar(mallaCaja, mArtesaMundo, { color: [0.08, 0.08, 0.08], usarLuz: false });
        // Agua dentro de la artesa (nivel 3: artesa -> agua).
        const mAguaLocal = componerModelo([0, 0.35, 0], 0, 0, 0, [2.6, 1, 1]);
        const mAguaMundo = multiplicarMatrices(mArtesaMundo, mAguaLocal);
        dibujar(mallaPlano, mAguaMundo, { color: [0.18, 0.48, 0.58], usarLuz: true, cull: false });
    }

    // --- SILOS de alimento ---
    for (const posSilo of [POS_SILO_1, POS_SILO_2]) {
        // Cuerpo cilindrico aproximado con esfera escalada.
        dibujar(mallaEsfera, componerModelo(
            [posSilo[0], posSilo[1] + 2.5, posSilo[2]],
            0, 0, 0, [1.2, 2.5, 1.2]
        ), { color: [0.7, 0.72, 0.75], usarLuz: true });
        dibujar(mallaCaja, componerModelo(
            [posSilo[0], posSilo[1] + 0.3, posSilo[2]],
            0, 0, 0, [1.8, 0.6, 1.8]
        ), { textura: texturaConcreto, usarLuz: true });
    }

    // --- BOYAS (Paso 7: esferas pequeñas) ---
    for (const posBoya of POSICIONES_BOYAS) {
        dibujar(mallaEsferaBoya, componerModelo(
            posBoya,
            0, estado.aireador * 0.5, 0, [0.15, 0.15, 0.15]
        ), { color: [0.9, 0.3, 0.1], usarLuz: true });
    }

    // ============================================================
    // PASO 11/13: TRUTCHAS COMO HIJOS DEL ESTANQUE (jerarquía 3 niveles)
    //   scene → estanque → pez
    //   M_mundo = M_estanque · M_local
    //   M_local = T(punto elipse) · R(rumbo tangente) · S(talla)
    // Revolución = avance por la elipse (ángulo INTEGRADO, no
    // reloj×factor). Rotación propia = orientación del cuerpo por
    // la tangente de la elipse.
    // ============================================================
    for (let i = 0; i < TRUTCHAS.length; i++) {
        const t = TRUTCHAS[i];
        const e = elipseEstanque(t.estanque);
        const ce = centroEstanque(t.estanque);
        // Ángulo INTEGRADO con fase independiente por trucha.
        const ang = entidad.trucha.anguloOrbita * t.velOrbita + i * 1.7;
        // Punto de la elipse (revolución orbital).
        const rx = Math.cos(ang) * e.rx;
        const rz = Math.sin(ang) * e.rz;
        // Tangente → orientación del cuerpo (rumbo tangencial).
        const tx = -Math.sin(ang) * e.rx;
        const tz = Math.cos(ang) * e.rz;
        const rumbo = Math.atan2(tx, tz);

        // Paso 13: M_local = T(centro elipse sobre superficie agua) · R(rumbo) · S(talla)
        const mLocal = componerModelo(
            [rx, ce[1] + e.radioAgua, rz],
            0, rumbo, 0, t.tam
        );
        // M_estanque posiciona el centro del estanque en el mundo.
        const mEstanque = traslacion(ce[0], ce[1], ce[2]);
        // M_mundo = M_estanque · M_local  → pez hereda del estanque.
        const mundo = multiplicarMatrices(mEstanque, mLocal);
        dibujar(mallaEsferaBoya, mundo, {
            textura: texturaTrucha,
            usarLuz: true
        });
    }

    // --- EDIFICIOS admin/lab (techo de teja) ---
    for (const posEd of [POS_EDIFICIO_1, POS_EDIFICIO_2]) {
        dibujar(mallaCaja, componerModelo(posEd, 0, 0, 0, [8, 3, 6]), {
            textura: texturaConcreto, usarLuz: true
        });
        dibujar(mallaCaja, componerModelo(
            [posEd[0], posEd[1] + 3.4, posEd[2]],
            0, 0, 0, [9, 0.5, 7]
        ), { textura: texturaTeja, usarLuz: true });
    }

    // === PASO 10: CARTEL "CIP CHUCUITO · UNAP" EMISIVO ===
    // Poste de madera.
    dibujar(mallaCaja, componerModelo(
        [POS_CARTEL[0], POS_CARTEL[1] + 2, POS_CARTEL[2]],
        0, 0, 0, [0.2, 4, 0.2]
    ), { textura: texturaMadera, usarLuz: true });
    // Panel del cartel: EMISIVO (se lee de noche). Paso 10.
    dibujar(mallaCaja, componerModelo(
        [POS_CARTEL[0], POS_CARTEL[1] + 4.2, POS_CARTEL[2]],
        0, 0, 0, [5, 1.5, 0.1]
    ), { textura: texturaCartelEmisivo, usarLuz: true, emisivo: true });

    // --- CAMINO de tierra ---
    dibujar(mallaPlano, componerModelo([0, 0.05, 0], 0, 0, 0, [60, 1, 4]), {
        color: [0.55, 0.45, 0.3], usarLuz: true, cull: false
    });

    // --- CERCO PERIMETRAL (postes simples) ===
    const radioCercoPostes = 40;
    const numPostes = 24;
    for (let i = 0; i < numPostes; i++) {
        const ang = (i / numPostes) * Math.PI * 2;
        const px = Math.cos(ang) * radioCercoPostes;
        const pz = Math.sin(ang) * radioCercoPostes;
        dibujar(mallaCaja, componerModelo([px, alturaTerreno(px, pz) + 1, pz], 0, 0, 0, [0.15, 2, 0.15]), {
            color: [0.4, 0.35, 0.3], usarLuz: true
        });
    }

    // --- VEGETACION ---
    // Ichu al oeste (x < -25): esferas pequeñas doradas.
    for (let i = 0; i < 15; i++) {
        const ix = -28 - (i % 5) * 2.5;
        const iz = -15 + Math.floor(i / 5) * 8;
        const iy = alturaTerreno(ix, iz);
        dibujar(mallaEsferaBoya, componerModelo([ix, iy + 0.4, iz], 0, i * 0.7, 0, [0.6, 0.8, 0.6]), {
            color: [0.75, 0.68, 0.3], usarLuz: true
        });
    }
    // Totora al extremo este (fondo, cerca del lago lejano).
    for (let i = 0; i < 10; i++) {
        const tx = 38 + (i % 5) * 2;
        const tz = -8 + Math.floor(i / 5) * 5;
        dibujar(mallaCaja, componerModelo([tx, alturaTerreno(tx, tz) + 1, tz], 0, 0, 0, [0.1, 2.5, 0.1]), {
            color: [0.3, 0.5, 0.2], usarLuz: true
        });
    }
    // Eucaliptos junto a edificios.
    for (let i = 0; i < 4; i++) {
        const ex = POS_EDIFICIO_1[0] - 3 + i * 5;
        const ez = POS_EDIFICIO_1[2] + 5;
        dibujar(mallaCaja, componerModelo([ex, alturaTerreno(ex, ez) + 2, ez], 0, 0, 0, [0.3, 4, 0.3]), {
            color: [0.4, 0.3, 0.2], usarLuz: true
        });
        dibujar(mallaEsferaBoya, componerModelo([ex, alturaTerreno(ex, ez) + 4.5, ez], 0, 0, 0, [1.5, 1.8, 1.5]), {
            color: [0.2, 0.45, 0.2], usarLuz: true
        });
    }

    // --- AIREADORES de superficie (en estanque B) ---
    dibujar(mallaCaja, componerModelo(
        [POS_ESTANQUE_B[0] - 2, POS_ESTANQUE_B[1] + TAM_ESTANQUE_B[1] * 0.7 + 0.2, POS_ESTANQUE_B[2] + 2],
        0, estado.aireador, 0, [0.5, 0.3, 0.5]
    ), { color: [0.6, 0.6, 0.65], usarLuz: true });

    // --- ESCALA DE NIVEL (junto a estanque A) ---
    dibujar(mallaCaja, componerModelo(
        [POS_ESTANQUE_A[0] + TAM_ESTANQUE_A[0] / 2 + 0.5, POS_ESTANQUE_A[1] + 1, POS_ESTANQUE_A[2]],
        0, 0, 0, [0.1, 1.5, 0.3]
    ), { color: [0.9, 0.9, 0.2], usarLuz: true });

    // Paso 13: verificación numérica de herencia jerárquica (stub).
    // verificarHerencia();
}

// ------------------------------------------------------------
// PASO 13 - VERIFICACION NUMERICA DE JERARQUIA (test de consola)
// Se ejecuta una sola vez al inicio para validar que la Luna/
// pez hereda la traslación del padre. NO se llama en runtime.
// ------------------------------------------------------------
function verificarHerencia() {
    // Pez en estanque B: M_mundo = M_estanque · M_local
    const ce = centroEstanque("B");
    const mEstanque = traslacion(ce[0], ce[1], ce[2]);
    const mLocal = componerModelo([1, 0.6, 0.5], 0, 0, 0, [0.4, 0.12, 0.11]);
    const mundo = multiplicarMatrices(mEstanque, mLocal);
    // La columna de traslación (índices 12,13,14) debe ser la suma.
    const esperado = [ce[0] + 1, ce[1] + 0.6, ce[2] + 0.5];
    const ok = Math.abs(mundo[12] - esperado[0]) < 1e-5 &&
               Math.abs(mundo[13] - esperado[1]) < 1e-5 &&
               Math.abs(mundo[14] - esperado[2]) < 1e-5;
    console.assert(ok, "HERENCIA: la traslación del pez no heredó el estanque");
    return ok;
}

// ------------------------------------------------------------
// PASO 4 - LOOP PRINCIPAL
// ------------------------------------------------------------
function loopPrincipal(ms) {
    const tiempo = ms * 0.001;
    const dt = primerFrame ? 0 : Math.min(tiempo - tiempoAnterior, 0.1);
    tiempoAnterior = tiempo;
    primerFrame = false;

    actualizar(dt);
    renderizar();

    requestAnimationFrame(loopPrincipal);
}

// Paso 13: validación numérica de herencia (una vez, en consola).
verificarHerencia();

requestAnimationFrame(loopPrincipal);
