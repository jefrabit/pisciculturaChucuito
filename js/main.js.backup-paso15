// ------------------------------------------------------------
// PASO 9/10 - TEXTURAS PROCEDURALES VIA CANVAS 2D
// ------------------------------------------------------------
// REUTILIZA: crearCanvasTextura, subirTextura (de Fase 1).
// Se AMPLIAN con generateMipmap + filtros mipmap para texturas
// que se ven a distinto zoom (cámara interactiva Paso 15).
//
// DEV: como todo es canvas, sigue funcionando desde file://
// (sin CORS). Esto es una DEVIACION JUSTIFICADA de la guia
// Paso 10 (que carga jpg desde server) por la restriccion
// "sin imagenes, natural de html/js/css".
// ------------------------------------------------------------
function crearCanvasTextura(ancho, alto, dibujar) {
    const c = document.createElement("canvas");
    c.width = ancho;
    c.height = alto;
    const ctx = c.getContext("2d");
    dibujar(ctx, ancho, alto);
    return c;
}

// Textura "real" con mipmap (para uso con cámara interactiva).
function subirTexturaMip(canvasElemento) {
    const tex = gl.createTexture();
    gl.bindTexture(gl.TEXTURE_2D, tex);
    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, canvasElemento);
    gl.generateMipmap(gl.TEXTURE_2D);
    // Filtros mipmap lineales (Paso 10: LINEAR_MIPMAP_LINEAR + LINEAR).
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
    // Wrap coherente: REPEAT horizontal, CLAMP_TO_EDGE vertical.
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT);
    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
    return tex;
}

// --- Paso 10: texturas reales/similares (canvas) ---

// Muro de concreto gris rugoso con manchas de algas (estanques/edificios).
const texturaConcreto = subirTexturaMip(crearCanvasTextura(128, 128, (ctx, w, h) => {
    ctx.fillStyle = "#8a8a80";
    ctx.fillRect(0, 0, w, h);
    // Ruido granular.
    for (let i = 0; i < 3000; i++) {
        const x = Math.random() * w;
        const y = Math.random() * h;
        const g = 100 + Math.random() * 80;
        ctx.fillStyle = `rgb(${g},${g},${g - 10})`;
        ctx.fillRect(x, y, 2, 2);
    }
    // Grietas sutiles.
    ctx.strokeStyle = "rgba(60,60,55,0.3)";
    ctx.lineWidth = 1;
    for (let i = 0; i < 6; i++) {
        ctx.beginPath();
        ctx.moveTo(Math.random() * w, Math.random() * h);
        ctx.lineTo(Math.random() * w, Math.random() * h);
        ctx.stroke();
    }
    // Manchas de algas verde-azuladas.
    for (let i = 0; i < 40; i++) {
        const x = Math.random() * w;
        const y = Math.random() * h;
