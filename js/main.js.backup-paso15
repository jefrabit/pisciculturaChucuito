// ------------------------------------------------------------
// PASO 15 - CAMARA INTERACTIVA (estado esférico)
// Target fijo en el centro de la cascada de estanques.
// ------------------------------------------------------------
// NOTA: la guia Paso 15 usa el centro del Sistema Solar como
// target. Aqui el target es el centro de la piscicultura.
// La escena NO se mueve: solo el observador.
const camera = {
    target: [0, 2, 0],            // centro de la cascada de estanques
    distancia: 45,                 // terreno 90×90 → distancia generosa
    distanciaMin: 8,               // clamp: escena grande
    distanciaMax: 120,
    azimut: 0.4,
    elevacion: 0.35,
    sensibilidadMouse: 0.006,
    sensibilidadZoom: 0.015
};

function limitar(valor, minimo, maximo) {
    return Math.max(minimo, Math.min(maximo, valor));
}

function obtenerEyeCamara() {
    const cosElev = Math.cos(camera.elevacion);
    const x = camera.target[0] + camera.distancia * cosElev * Math.sin(camera.azimut);
    const y = camera.target[1] + camera.distancia * Math.sin(camera.elevacion);
    const z = camera.target[2] + camera.distancia * cosElev * Math.cos(camera.azimut);
    return [x, y, z];
}

function obtenerViewCamara() {
    const eye = obtenerEyeCamara();
    return mirarDesde(eye, camera.target, [0, 1, 0]);
}

function reiniciarCamara() {
    camera.target = [0, 2, 0];
    camera.distancia = 45;
    camera.azimut = 0.4;
    camera.elevacion = 0.35;
}

// ------------------------------------------------------------
// PASO 15 - INTERACCION: MOUSE (orbita + zoom)
// ------------------------------------------------------------
let arrastrando = false;
let mouseAnteriorX = 0;
let mouseAnteriorY = 0;

canvas.addEventListener("mousedown", (evento) => {
    arrastrando = true;
    mouseAnteriorX = evento.clientX;
    mouseAnteriorY = evento.clientY;
    canvas.classList.add("arrastrando");
});

window.addEventListener("mouseup", () => {
    arrastrando = false;
    canvas.classList.remove("arrastrando");
});

window.addEventListener("mousemove", (evento) => {
    if (!arrastrando) return;
    const dx = evento.clientX - mouseAnteriorX;
    const dy = evento.clientY - mouseAnteriorY;
    mouseAnteriorX = evento.clientX;
    mouseAnteriorY = evento.clientY;

    camera.azimut -= dx * camera.sensibilidadMouse;
    camera.elevacion += dy * camera.sensibilidadMouse;

    // Evitar los polos (degeneración de lookAt).
    const limiteVertical = Math.PI / 2 - 0.05;
    camera.elevacion = limitar(camera.elevacion, -limiteVertical, limiteVertical);
});

// Rueda: zoom con preventDefault + passive:false (Paso 15).
canvas.addEventListener("wheel", (evento) => {
    evento.preventDefault();
    camera.distancia += evento.deltaY * camera.sensibilidadZoom;
    camera.distancia = limitar(camera.distancia, camera.distanciaMin, camera.distanciaMax);
}, { passive: false });

// ------------------------------------------------------------
// PASO 15 - INTERACCION: TECLADO
// Flechas (±0.08), +/- (±0.5), R reset.
// ------------------------------------------------------------
window.addEventListener("keydown", (evento) => {
    const pasoAngular = 0.08;
    const pasoZoom = 0.5;
    switch (evento.key) {
        case "ArrowLeft":  camera.azimut -= pasoAngular; evento.preventDefault(); break;
        case "ArrowRight": camera.azimut += pasoAngular; evento.preventDefault(); break;
        case "ArrowUp":    camera.elevacion += pasoAngular; evento.preventDefault(); break;
        case "ArrowDown":  camera.elevacion -= pasoAngular; evento.preventDefault(); break;
        case "+":
        case "=": camera.distancia -= pasoZoom; break;
        case "-": camera.distancia += pasoZoom; break;
        case "r":
        case "R": reiniciarCamara(); break;
    }
    const limiteVertical = Math.PI / 2 - 0.05;
    camera.elevacion = limitar(camera.elevacion, -limiteVertical, limiteVertical);
    camera.distancia = limitar(camera.distancia, camera.distanciaMin, camera.distanciaMax);
});

