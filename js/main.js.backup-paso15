// ------------------------------------------------------------
// PASO 9/14 - CREACION DE VAOs Y BUFFERS
// Formato: pos(3)|normal(3)|uv(2) = 8 floats, stride 32 bytes.
// ------------------------------------------------------------
function crearVAO(datosMalla, programa) {
    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    const vbo = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    gl.bufferData(gl.ARRAY_BUFFER, datosMalla.vertices, gl.STATIC_DRAW);

    const ibo = gl.createBuffer();
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibo);
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, datosMalla.indices, gl.STATIC_DRAW);

    const stride = 8 * Float32Array.BYTES_PER_ELEMENT;
    const locPos = gl.getAttribLocation(programa, "aPosition");
    gl.enableVertexAttribArray(locPos);
    gl.vertexAttribPointer(locPos, 3, gl.FLOAT, false, stride, 0);

    const locNorm = gl.getAttribLocation(programa, "aNormal");
    gl.enableVertexAttribArray(locNorm);
    gl.vertexAttribPointer(locNorm, 3, gl.FLOAT, false, stride, 3 * Float32Array.BYTES_PER_ELEMENT);

    const locUV = gl.getAttribLocation(programa, "aTexCoord");
    gl.enableVertexAttribArray(locUV);
    gl.vertexAttribPointer(locUV, 2, gl.FLOAT, false, stride, 6 * Float32Array.BYTES_PER_ELEMENT);

    gl.bindVertexArray(null);
    return { vao, count: datosMalla.indices.length };
}

// Geometrias instanciadas (como Fase 1).
const mallaTerreno = crearVAO(crearMallaTerreno(), program);
const mallaCaja = crearVAO(crearMallaCaja(), program);
const mallaPlano = crearVAO(crearMallaPlano(), program);
const mallaEsfera = crearVAO(crearMallaEsfera(1.0, 24, 32), program);
// Esfera de baja resolucion para boyas pequeñas.
const mallaEsferaBoya = crearVAO(crearMallaEsfera(1.0, 12, 16), program);

// ------------------------------------------------------------
// PASo 14 - VAO PARA LÍNEAS (orbitas/trayectorias)
// Dibujado con gl.LINE_LOOP; sin índices, solo posición.
// ------------------------------------------------------------
function crearVAOLinea(puntos) {
    gl.useProgram(programaLinea);
    const vao = gl.createVertexArray();
    gl.bindVertexArray(vao);

    const vbo = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, vbo);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(puntos), gl.STATIC_DRAW);

    const locPos = gl.getAttribLocation(programaLinea, "aPosition");
    gl.enableVertexAttribArray(locPos);
    gl.vertexAttribPointer(locPos, 3, gl.FLOAT, false, 0, 0);

    gl.bindVertexArray(null);
    return { vao, cantidad: puntos.length / 3 };
}

// Paso 14: geometría procedural de órbita (circunferencia en XZ).
// La misma funcion sirve para elipse (radios distintos).
function crearOrbita(radioX, radioZ, segmentos = 64) {
    const puntos = [];
    for (let i = 0; i < segmentos; i++) {
        const t = i / segmentos;
        const angulo = t * Math.PI * 2;
        puntos.push(Math.cos(angulo) * radioX, 0, Math.sin(angulo) * radioZ);
    }
    return puntos;
}

