const POS_EDIFICIO_2 = [4, 0, -24];

// Paso 11: parámetros de las elipses de los peces por estanque.
// Cada pez orbita sobre una elipse alrededor del centro del estanque.
const ELIPSE_A = { cx: POS_ESTANQUE_A[0], cz: POS_ESTANQUE_A[2], rx: TAM_ESTANQUE_A[0] * 0.32, rz: TAM_ESTANQUE_A[2] * 0.32, radioAgua: TAM_ESTANQUE_A[1] * 0.7 };
const ELIPSE_B = { cx: POS_ESTANQUE_B[0], cz: POS_ESTANQUE_B[2], rx: TAM_ESTANQUE_B[0] * 0.32, rz: TAM_ESTANQUE_B[2] * 0.32, radioAgua: TAM_ESTANQUE_B[1] * 0.7 };
const ELIPSE_C = { cx: POS_ESTANQUE_C[0], cz: POS_ESTANQUE_C[2], rx: TAM_ESTANQUE_C[0] * 0.30, rz: TAM_ESTANQUE_C[2] * 0.30, radioAgua: TAM_ESTANQUE_C[1] * 0.6 };

// Posiciones relativas de las truchas dentro de cada estanque
// (offset respecto al centro del estanque). Cada una lleva su
// propio ángulo INTEGRADO de órbita alrededor de su elipse.
